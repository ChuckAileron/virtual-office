{
	auto_https disable_redirects
	# Los navegadores no envían SNI al conectarse por IP: sin esto, Caddy no
	# sabe qué certificado servir y la conexión HTTPS falla con "internal error".
	default_sni {$LAN_IP}
}

https://{$LAN_IP}, https://oficina.lan {
	tls internal

	# Certificado raíz para instalarlo en cada equipo: https://<IP>/ca.crt
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Disposition "attachment; filename=oficina-virtual-ca.crt"
		file_server
	}

	handle /janus* {
		reverse_proxy janus:8188
	}

	handle {
		reverse_proxy server:3000
	}
}

http://{$LAN_IP} {
	redir https://{$LAN_IP}{uri} permanent
}
