# Copia a .env o, mejor, ejecuta: npm run setup
LAN_IP=192.168.1.100
POSTGRES_PASSWORD=cambia-esto
JWT_SECRET=cambia-esto-por-una-cadena-larga-aleatoria
JANUS_ROOM_SECRET=secreto-aleatorio-de-32-caracteres-o-mas
# Secreto HMAC que Janus usa para verificar los tokens firmados (token_auth).
JANUS_AUTH_SECRET=secreto-aleatorio-de-32-caracteres-o-mas
# Clave de administración de VideoRoom: solo el servidor puede crear salas.
JANUS_ADMIN_KEY=clave-aleatoria-de-16-caracteres

# DNS de los contenedores: fijado en docker-compose.yml a Quad9 (9.9.9.9),
# sin variable que lo cambie. npm run up lo verifica al finalizar.

# Solo Docker lo define (lo usa el servidor para crear salas en Janus):
# JANUS_API_URL=http://janus:8088/janus

# Solo para desarrollo local sin Docker (npm run dev:server):
# DATABASE_URL=postgresql://office:office@localhost:5432/office
# PORT=3000
# IDLE_MS=300000
# PET_TICK_MS=700
